# Modèle de configuration locale.
# Les réglages sensibles (accès, base de données, contacts, tarifs) ne sont
# volontairement PAS listés ici : ils se configurent côté hébergement.
APP_NAME=Aya — Komara Agency
PORT=8000
DEFAULT_LANGUAGE=fr

# Recherche dans la base de connaissances : auto | keyword | embed
RAG_BACKEND=auto
RAG_TOP_K=3
RAG_MIN_SCORE=0.65
KNOWLEDGE_BASE_PATH=./knowledge_base

# Dossier de la base SQLite en local (une base PostgreSQL fournie par
# l'hébergement prend le dessus automatiquement).
MEMORY_DIR=./data
