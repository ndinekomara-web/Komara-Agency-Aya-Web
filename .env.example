# === Application ===
APP_NAME=Aya — Komara Agency
PORT=8000
DEFAULT_LANGUAGE=fr
# Mot de passe facultatif : s'il est rempli, l'accès à la conversation est protégé.
APP_ACCESS_TOKEN=

# === Recherche dans la base de connaissances ===
# auto    : embeddings si installés, sinon mots-clés (recommandé)
# keyword : installation légère, aucun modèle à télécharger
# embed   : embeddings obligatoires
RAG_BACKEND=auto
RAG_TOP_K=3
RAG_MIN_SCORE=0.65
KNOWLEDGE_BASE_PATH=./knowledge_base

# === Base de données ===
# Laisser vide en local (SQLite dans ./data).
# Sur Railway : ajouter le plugin PostgreSQL, DATABASE_URL est fourni automatiquement.
DATABASE_URL=

# === Stockage local ===
MEMORY_DIR=./data

# === Google Sheets (facultatif) ===
GOOGLE_SHEETS_ID=
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CREDENTIALS_PATH=./credentials.json
